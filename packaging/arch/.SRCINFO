pkgbase = arch-manager
	pkgdesc = Graphical Arch Linux manager: packages, updates, Snapper and maintenance (beta)
	pkgver = 0.7.0beta1
	pkgrel = 1
	url = https://github.com/tzkwork-sys/arch-manager
	arch = any
	license = GPL-3.0-only
	checkdepends = python-pytest
	checkdepends = desktop-file-utils
	depends = python
	depends = pyside6>=6.7
	depends = qt6-svg
	depends = pacman
	depends = pacman-contrib
	depends = fakeroot
	depends = sudo
	depends = polkit
	depends = appstream
	depends = xterm
	depends = hicolor-icon-theme
	optdepends = yay: AUR applications and updates
	optdepends = snapper: snapshot management (requires an existing root configuration)
	optdepends = btrfs-progs: Btrfs snapshot management
	optdepends = smartmontools: SMART disk diagnostics
	optdepends = nvme-cli: additional NVMe diagnostics
	optdepends = polkit-kde-agent: graphical authentication in KDE Plasma
	optdepends = polkit-gnome: graphical authentication in other desktops
	optdepends = konsole: preferred terminal in KDE Plasma
	optdepends = vim: default pacdiff comparison tool
	optdepends = meld: alternative pacdiff viewer (configure DIFFPROG)
	options = !debug
	options = !strip
