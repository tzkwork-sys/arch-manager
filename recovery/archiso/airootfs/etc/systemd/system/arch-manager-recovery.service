[Unit]
Description=Arch Manager Recovery wizard
Wants=arch-manager-recovery-watchdog.service systemd-udev-settle.service
After=arch-manager-recovery-watchdog.service systemd-udev-settle.service
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=TZ=Europe/Moscow
ExecStart=/usr/local/bin/arch-manager-recovery
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=no
TTYVTDisallocate=no
TimeoutStopSec=5s
KillMode=control-group
Restart=no

[Install]
WantedBy=multi-user.target
